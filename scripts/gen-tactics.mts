// Freezes the chosen Lichess puzzles (CC0) used by the Academy into src/academy/content/tactic-positions.ts.
// `npx tsx scripts/gen-tactics.mts`  — positions come from public/puzzles/lichess-starter.json; edit PICKS below to change them.
import { readFileSync, writeFileSync } from 'node:fs';
import { Position } from '../src/chess/position';

const PICKS = (process.argv[2] ? process.argv[2].split(',') : readFileSync(new URL('./academy-picks.txt', import.meta.url), 'utf8').split(/\s+/)).filter(Boolean);
const pack = JSON.parse(readFileSync(new URL('../public/puzzles/lichess-starter.json', import.meta.url), 'utf8'));
const byId = new Map<string, any>(pack.puzzles.map((p: any) => [p.id, p]));
const out: Record<string, unknown> = {};
for (const raw of PICKS) {
  const id = raw.startsWith('li:') ? raw : `li:${raw}`;
  const p = byId.get(id);
  if (!p) throw new Error(`unknown puzzle ${id}`);
  const ms: string[] = p.moves.split(' ');
  const pos = new Position(p.fen);
  const setup = pos.parseUci(ms[0]!);
  if (setup === undefined) throw new Error(`${id}: bad setup move`);
  pos.makeMove(setup);
  const fen = pos.toFen();
  const q = pos.clone();
  const san: string[] = [];
  const first = pos.turn;
  let fullmove = Number(fen.split(' ')[5]);
  const parts: string[] = [];
  let turn = pos.turn;
  for (const u of ms.slice(1)) {
    const m = q.parseUci(u);
    if (m === undefined) throw new Error(`${id}: bad move ${u}`);
    const s = q.toSan(m);
    san.push(s);
    parts.push(turn === 0 ? `${fullmove}.${s}` : parts.length === 0 ? `${fullmove}…${s}` : s);
    if (turn === 1) fullmove++;
    q.makeMove(m);
    turn = q.turn;
  }
  out[id.slice(3)] = { fen, line: ms.slice(1), san, text: parts.join(' '), side: first === 0 ? 'White' : 'Black', rating: p.rating, themes: p.themes };
}
const body = `/**\n * Puzzle positions used as Academy exercises. Frozen from the Lichess puzzle database (CC0 1.0, see THIRD_PARTY_NOTICES.md),\n * already advanced past the opponent's set-up move. Generated by scripts/gen-tactics.mts from scripts/academy-picks.txt.\n */\nexport interface TacticPosition { fen: string; line: string[]; san: string[]; text: string; side: 'White' | 'Black'; rating: number; themes: string[] }\nexport const TP: Record<string, TacticPosition> = ${JSON.stringify(out, null, 1).replace(/"([a-zA-Z0-9]+)": /g, (m, k) => (/^[0-9]/.test(k) ? `'${k}': ` : `${k}: `))};\n`;
writeFileSync(new URL('../src/academy/content/tactic-positions.ts', import.meta.url), body);
console.log(`${Object.keys(out).length} positions written`);
